# Hébergement Apache (paul-laurent.fr/centurion-scrabble).
# Le dictionnaire est un binaire de ~300 Ko qui se comprime à ~180 Ko :
# la compression de transport est indispensable ici.

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/json image/svg+xml application/octet-stream
</IfModule>

<IfModule mod_mime.c>
  AddType application/octet-stream .dawg
</IfModule>

# Les fichiers produits par Vite portent une empreinte dans leur nom : ils
# peuvent être mis en cache longtemps.
#
# Le dictionnaire, lui, garde toujours le même nom alors que son contenu
# change à chaque correction du lexique. Il est réclamé avec sa date de
# construction en paramètre (voir src/main.js), ce qui lui donne une adresse
# neuve à chaque version : le cache d'un an reste donc sûr.
#
# Cette date vient du manifeste, qui doit donc rester frais — d'où son
# expiration courte. C'est le seul fichier qui ne doit jamais dormir en cache.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType application/octet-stream "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/html "access plus 5 minutes"
  ExpiresByType application/json "access plus 0 seconds"
</IfModule>
